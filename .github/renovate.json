{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am every weekday"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "ignoreDeps": ["awscli"],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "⬆️",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docs\\/docs\\/rhfest\\/index\\.md$/"],
      "matchStrings": [
        "RotorHazard/rhfest-action@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "rev: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "ghcr\\.io/rotorhazard/rhfest-action:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "RotorHazard/rhfest-action",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "addLabels": ["python"]
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["tool.uv.dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin",
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
